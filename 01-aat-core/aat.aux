\@writefile{toc}{\contentsline {part}{\numberline {I}Adaptive Systems Under Uncertainty}{1}{part.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Driving in snow as a literal adaptive agent — the worked AAT instance recurring across Part I and beyond. Every visible element has a formal counterpart: windshield occlusion is the mismatch, precipitation modulated by vehicle speed is the drift, the wiper sweep is the correction, the wiper-speed dial is the adaptive tempo, and the still-see-the-road threshold is the model capacity. Persistence is certified while gain times capacity outpaces drift; at that threshold the certificate is lost, and for a corrector whose correction is exactly as strong as its sector floor (the wiper that sweeps at one fixed rate) a worst-case drift can then defeat it. Ordinary snowfall is not worst-case, so for it the threshold marks lost assurance, not certain failure.}}{3}{figure.0.2}\protected@file@percent }
\newlabel{fig:fig-driver-snow-foundation}{{2}{3}{Driving in snow as a literal adaptive agent — the worked AAT instance recurring across Part I and beyond. Every visible element has a formal counterpart: windshield occlusion is the mismatch, precipitation modulated by vehicle speed is the drift, the wiper sweep is the correction, the wiper-speed dial is the adaptive tempo, and the still-see-the-road threshold is the model capacity. Persistence is certified while gain times capacity outpaces drift; at that threshold the certificate is lost, and for a corrector whose correction is exactly as strong as its sector floor (the wiper that sweeps at one fixed rate) a worst-case drift can then defeat it. Ordinary snowfall is not worst-case, so for it the threshold marks lost assurance, not certain failure}{figure.0.2}{}}
\newlabel{fig:fig-driver-snow-foundation@cref}{{[figure][2][]2}{[1][3][]3}{}{}{}}
