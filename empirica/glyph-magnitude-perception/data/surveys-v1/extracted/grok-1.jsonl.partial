{"id": "78f815347fe01d3b", "schema_version": "0.8", "record_type": "negative", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L794", "section_path": ["from panes", "leftover BMP (after a block census)"], "title": "Kangxi/CJK radicals, strokes, Yi radicals, presentation twins, remaining Nd — not amount", "glyphs": null, "codepoints": null, "axis": "Kangxi/CJK radicals, strokes, Yi radicals, presentation twins, remaining Nd — not amount", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "unstated", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "Not amount (looked at names / samples, not dumped as full panes): Kangxi radicals, CJK radicals supplement, CJK strokes, Yi radicals (catalogs of different pictures; \"SECOND ONE/TWO/THREE\" are variant *forms* of a radical). Vertical Forms and Small Form Variants are presentation twins, not scales. Remaining BMP Nd 0-9 (Bengali, Gurmukhi, Gujarati, Kannada, Lao, Myanmar, Shan, Mongolian, Tai Tham hora/tham, New Tai Lue, ...) is the same denoted kind already sampled.", "transcription_confidence": "clear", "migrator_notes": "mixed evidence basis: 'looked at names / samples, not dumped as full panes'", "open": null, "negative_kind": "verified-absent"}
