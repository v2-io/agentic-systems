{"id": "61d62bc4dffbe865", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L141-L143", "section_path": ["size of a same primitive", "filled round, small → large — strong"], "title": "filled round, small → large", "glyphs": "·•●⬤", "codepoints": ["U+00B7", "U+2022", "U+25CF", "U+2B24"], "axis": "filled round, small → large", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "·•●⬤\n\nA dot, a bullet, a black circle, a large black circle. I might also accept `.` at the front. ◦ is hollow, so I keep it off this line.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "0730f734ee75f613", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L147-L149", "section_path": ["size of a same primitive", "hollow round, small → large — strong"], "title": "hollow round, small → large", "glyphs": "◦○◯", "codepoints": ["U+25E6", "U+25CB", "U+25EF"], "axis": "hollow round, small → large", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "◦○◯\n\nWhite bullet / white circle / large circle.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "82eacb148e9d95fd", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L153-L155", "section_path": ["size of a same primitive", "circle fill — strong"], "title": "circle fill", "glyphs": "○●", "codepoints": ["U+25CB", "U+25CF"], "axis": "circle fill", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "○●\n\nEmpty → full. ◎ is *nested rings*, a different axis (it can feel “more” than ○ and also “less solid” than ●). I do not put ○◎● on one line without that caveat.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "12d23a5baf9078d0", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L159-L161", "section_path": ["size of a same primitive", "concentric / nested round — strong"], "title": "concentric / nested round", "glyphs": "⊙⊚◎", "codepoints": ["U+2299", "U+229A", "U+25CE"], "axis": "concentric / nested round", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "⊙⊚◎\n\nDot-in-circle → ring-in-circle → bullseye. “More circle inside circle.” ⦿ is ⊙ filled; ⦾⦿ is empty/filled of the double-circle.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "33e7e3eabc0e6941", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L165-L167", "section_path": ["size of a same primitive", "squares, size — strong"], "title": "squares, size", "glyphs": "▪■⬛", "codepoints": ["U+25AA", "U+25A0", "U+2B1B"], "axis": "squares, size", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "▪■⬛\n\nSmall black, black, large black. Hollow: ▫□⬜.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "a4cf84600f6fd5f1", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L171-L173", "section_path": ["size of a same primitive", "squares, fill — strong"], "title": "squares, fill", "glyphs": "□■", "codepoints": ["U+25A1", "U+25A0"], "axis": "squares, fill", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "□■\n\nEmpty → full. Same for △▲, ▷▶, ◯● if you only want a pair.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
{"id": "017bdceeab0c3dff", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L177-L179", "section_path": ["size of a same primitive", "stars, size — medium–strong"], "title": "stars, size", "glyphs": "⭒⭑⭐", "codepoints": ["U+2B52", "U+2B51", "U+2B50"], "axis": "stars, size", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "medium–strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "⭒⭑⭐\n\nSmall → medium. ☆★ is fill, not size. ✶✷✸✹ (6-point → 8 → heavy-8 → 12) feels like “more star” but messier than ⭒⭐.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
