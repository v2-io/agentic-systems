{"id": "f15192ac6a893aaa", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L125-L127", "section_path": ["pictorial — the shape *is* the amount", "integrals, nested — strong"], "title": "integrals, nested", "glyphs": "∫∬∭", "codepoints": ["U+222B", "U+222C", "U+222D"], "axis": "integrals, nested", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "∫∬∭\n\nOne, two, three. ∮ is a *kind* of integral, not “four,” so I stop.", "transcription_confidence": "clear", "migrator_notes": null, "open": null}
