{"id": "c8e1116e90c2ba54", "schema_version": "0.8", "record_type": "negative", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L879", "section_path": ["from panes", "Latin / IPA / phonetic — mutation sequences (looked at the glyphs)", "not a scale (still looked)"], "title": "turned letters, ligatures, Vietnamese precomposed piles — not a scale", "glyphs": null, "codepoints": null, "axis": "turned letters, ligatures, Vietnamese precomposed piles — not a scale", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "unstated", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "Turned letters (ɐ ɒ ǝ ʌ …) are orientations, not more/less. Ligatures ÆŒĲ are “two letters fused,” a pair with their parts, not a 1–2–3. Vietnamese precomposed piles (ốồổỗ…) are two-mark combos of the same two axes, not a third step.", "transcription_confidence": "clear", "migrator_notes": null, "open": null, "negative_kind": "verified-absent"}
{"id": "d360aee6dc66391b", "schema_version": "0.8", "record_type": "meta", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L883", "section_path": ["from panes", "Latin / IPA / phonetic — mutation sequences (looked at the glyphs)", "not a scale (still looked)"], "title": "walk plan: remaining missed BMP panes to CJK Radicals Supplement", "glyphs": null, "codepoints": null, "axis": "coverage", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "unstated", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "Still walking missed BMP panes in cp order with this aperture. After Latin Ext-C the next misses are Glagolitic, Coptic, Tifinagh, Ethiopic Extended, Cyrillic Ext-A — then Supplemental Punctuation (already done), then **CJK Radicals Supplement U+2E80**.", "transcription_confidence": "clear", "migrator_notes": null, "open": null, "meta_kind": "coverage-gap"}
{"id": "37fa7e42f5c01d8e", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L887", "section_path": ["from panes", "Latin / IPA / phonetic — mutation sequences (looked at the glyphs)", "Hangul Jamo (looked at the glyphs, not the names)"], "title": "Hangul ssang doubling", "glyphs": "ᄀᄁ ᄃᄄ ᄇᄈ ᄉᄊ ᄌᄍ", "codepoints": ["U+1100", "U+1101", "U+1103", "U+1104", "U+1107", "U+1108", "U+1109", "U+110A", "U+110C", "U+110D"], "axis": "Hangul ssang doubling", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "Strong", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "ᄀᄁ  ᄃᄄ  ᄇᄈ  ᄉᄊ  ᄌᄍ     one consonant → doubled (ssang). Strong. Same in the batchim: ᆨᆩ  ᆺᆻ.", "transcription_confidence": "clear", "migrator_notes": "five pairs plus batchim twins ᆨᆩ ᆺᆻ; one record because he states them as one move", "open": null}
{"id": "0a3d0f9fbb7a668c", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L889", "section_path": ["from panes", "Latin / IPA / phonetic — mutation sequences (looked at the glyphs)", "Hangul Jamo (looked at the glyphs, not the names)"], "title": "Hangul clusters as count-of-pieces", "glyphs": null, "codepoints": null, "axis": "Hangul clusters as count-of-pieces", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "weaker than ssang", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "The rest of the block is clusters (nieun-kiyeok, pieup-sios-kiyeok, …). Those are 2-jamo vs 3-jamo concatenations, not one body growing. I feel count-of-pieces the way I feel ⿰ vs ⿲, weaker than ssang.", "transcription_confidence": "interpreted", "migrator_notes": "'I feel count-of-pieces the way I feel ⿰ vs ⿲, weaker than ssang'", "open": null}
