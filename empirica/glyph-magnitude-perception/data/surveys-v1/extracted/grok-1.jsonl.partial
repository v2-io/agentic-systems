{"id": "d7d4170a2e183af8", "schema_version": "0.8", "record_type": "meta", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L664", "section_path": ["from panes", "Script decimal 0–9 (sampled, still < U+2E80)"], "title": "script decimal 0–9 — same denoted kind; prediction over remaining Nd runs", "glyphs": null, "codepoints": null, "axis": "script decimal 0–9 — same denoted kind; prediction over remaining Nd runs", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "unstated", "basis": "semantic-knowledge", "lineage": "unprompted", "constructed": false, "note_verbatim": "NKo `߀`–`߉`, Thai `๐`–`๙`, Devanagari `०`–`९`. Same denoted 0–9. NKo is the one I can almost sight-read as Western digits; Devanagari I know rather than *see*. Not a new kind. The other Indic/SE Asian Nd runs will be this again.", "transcription_confidence": "clear", "migrator_notes": "[migrator-inferred link] same script-decimal claim restated with the NKo/Devanagari split and a generalization prediction", "open": null, "predicted_generalization": "The other Indic/SE Asian Nd runs will be this again.", "revises": "68c43bea1e85e81f", "revision_kind": "refinement", "felt_immediacy_verbatim": "NKo is the one I can almost sight-read as Western digits; Devanagari I know rather than *see*."}
{"id": "1cb34bf1d76fff95", "schema_version": "0.8", "record_type": "sequence", "surveyor": "grok-1", "id_recipe": "sha256('survey-rec|grok-1|' + source_span)[:16]; source_span is L<line> or L<a>-L<b>, letter fragments for multi-record lines", "source_file": "grok-1.md", "source_span": "L672", "section_path": ["from panes", "leftover number / CJK / emoji-ext (dumped after the symbol-block walk)", "Mayan Numerals — strong (pictorial)"], "title": "Mayan Numerals 0–19", "glyphs": "𝋠𝋡𝋢𝋣𝋤𝋥𝋦𝋧𝋨𝋩𝋪𝋫𝋬𝋭𝋮𝋯𝋰𝋱𝋲𝋳", "codepoints": ["U+1D2E0", "U+1D2E1", "U+1D2E2", "U+1D2E3", "U+1D2E4", "U+1D2E5", "U+1D2E6", "U+1D2E7", "U+1D2E8", "U+1D2E9", "U+1D2EA", "U+1D2EB", "U+1D2EC", "U+1D2ED", "U+1D2EE", "U+1D2EF", "U+1D2F0", "U+1D2F1", "U+1D2F2", "U+1D2F3"], "axis": "Mayan Numerals 0–19", "direction_note": null, "epistemic_class": "interactive-guided-survey-anecdote", "felt_strength_verbatim": "strong (pictorial)", "basis": "perceived-directly", "lineage": "unprompted", "constructed": false, "note_verbatim": "𝋠𝋡𝋢𝋣𝋤𝋥𝋦𝋧𝋨𝋩𝋪𝋫𝋬𝋭𝋮𝋯𝋰𝋱𝋲𝋳\n\n0 is a shell; 1–4 are dots; 5 is a bar; then bar+dots, two bars, three bars, up to 19. I do not need the names. Same family as dice / tally, in vigesimal.", "transcription_confidence": "clear", "migrator_notes": null, "open": null, "felt_immediacy_verbatim": "I do not need the names."}
