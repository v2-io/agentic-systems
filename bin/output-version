#!/usr/bin/env ruby
# frozen_string_literal: true
#
# bin/output-version — per-volume semantic-version utility for the
# monograph build. Operates directly on each volume's mono-meta.yaml,
# reading/writing the `major` / `minor` / `patch` keys.
#
# Usage:
#   bin/output-version <volume-id> show
#   bin/output-version <volume-id> bump patch    # 0.1.0 → 0.1.1
#   bin/output-version <volume-id> bump minor    # 0.1.5 → 0.2.0
#   bin/output-version <volume-id> bump major    # 0.7.3 → 1.0.0
#
# <volume-id> is the slug (`aad`/`tst`/`loga`/`eli`) or the component-dir
# prefix (`01`/`02`/`03`/`04`).

require 'pathname'
require 'yaml'

ROOT_DIR = Pathname.new(__dir__).parent.expand_path
META_FILENAME = 'mono-meta.yaml'

VOLUME_DIRS = {
  '01' => '01-aat-core',         'aad' => '01-aat-core',
  '02' => '02-tst-core',         'tst' => '02-tst-core',
  '03' => '03-llm-core', 'loga' => '03-llm-core', 'logogenic' => '03-llm-core',
  '04' => '04-eli-core',              'eli' => '04-eli-core',
}.freeze

def meta_path_for(volume_id)
  dir = VOLUME_DIRS[volume_id.downcase]
  abort "unknown volume id: #{volume_id.inspect} (expected one of: " \
        "#{VOLUME_DIRS.keys.uniq.join(', ')})" unless dir

  path = ROOT_DIR / dir / META_FILENAME
  abort "no #{path.relative_path_from(ROOT_DIR)}" unless path.exist?
  path
end

def read_version(path)
  meta = YAML.safe_load(path.read) || {}
  [meta['major'] || 0, meta['minor'] || 0, meta['patch'] || 0]
end

def write_version(path, major, minor, patch)
  text = path.read
  text = text.sub(/^major:\s*\d+/, "major:       #{major}")
  text = text.sub(/^minor:\s*\d+/, "minor:       #{minor}")
  text = text.sub(/^patch:\s*\d+/, "patch:       #{patch}")
  path.write(text)
end

def bump(version, level)
  major, minor, patch = version
  case level
  when 'patch' then [major, minor, patch + 1]
  when 'minor' then [major, minor + 1, 0]
  when 'major' then [major + 1, 0, 0]
  else abort "unknown bump level: #{level.inspect} (expected patch|minor|major)"
  end
end

# ── CLI ─────────────────────────────────────────────────────────────────────

args = ARGV.dup
abort 'usage: bin/output-version <volume> show|bump <patch|minor|major>' if args.empty?

volume_id = args.shift
path = meta_path_for(volume_id)
current = read_version(path)
current_str = current.join('.')

cmd = args.shift || 'show'

case cmd
when 'show'
  puts current_str

when 'bump'
  level = args.shift
  abort 'usage: bin/output-version <volume> bump <patch|minor|major>' unless level
  new_version = bump(current, level)
  write_version(path, *new_version)
  puts "#{volume_id}: #{current_str} → #{new_version.join('.')}"

else
  abort 'usage: bin/output-version <volume> show|bump <patch|minor|major>'
end
