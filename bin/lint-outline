#!/usr/bin/env python3
"""
Lint an outline file against segment frontmatter dependencies.

Checks:
  1. Ordering violations: segment listed before a dependency in the outline
     (accepted-by-design violations are whitelisted per component in
     <component>/OUTLINE-accepted.md — still printed, marked accepted, exit green)
  2. Missing dependencies: segment depends on a slug that doesn't exist as a file
     (resolved against ALL components' src/ dirs, since deps are cross-component)
  3. Orphan segments: files in src/ not referenced in the outline
  4. Stage consistency: segment frontmatter `stage:` vs the OUTLINE row's stage
     column — disagreements, missing `stage:` fields, off-vocabulary values

Usage:
    bin/lint-outline [options] [OUTLINE_FILE]

    With no OUTLINE_FILE, checks ALL components:
    01-aat-core, 02-tst-core, 03-llm-core, 04-eli-core.
    (--graph/--svg/--diagrams/--section require an explicit OUTLINE_FILE,
    or default to 01-aat-core/OUTLINE.md with a notice.)

Options:
    --graph FILE    Write a Graphviz DOT file of the dependency graph
    --section S     Only check/graph a specific section (I, II, III, A, B)
    --svg FILE      Write SVG directly (requires dot command)
    --diagrams      Generate all dependency diagrams into src/img/
    --quiet         Only show violations, not summary
    --help          Show this help

Exit code 0 = clean (accepted-by-design ordering violations count as clean),
1 = violations found.
"""

import os
import re
import sys
import subprocess
from pathlib import Path
from collections import defaultdict

# ── Frontmatter parsing ────────────────────────────────────────────

def parse_frontmatter(filepath):
    """Extract slug, depends, and stage from YAML frontmatter."""
    result = {"slug": None, "depends": [], "stage": None, "type": None, "status": None}
    try:
        with open(filepath, "r") as f:
            lines = f.readlines()
    except (OSError, UnicodeDecodeError):
        return result

    if not lines or lines[0].strip() != "---":
        return result

    in_depends = False
    for line in lines[1:]:
        stripped = line.strip()
        if stripped == "---":
            break
        if stripped.startswith("slug:"):
            result["slug"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("stage:"):
            result["stage"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("type:"):
            result["type"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("status:"):
            result["status"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("depends:"):
            rest = stripped.split(":", 1)[1].strip()
            if rest:
                # Inline list: depends: [a, b, c] or depends: a
                rest = rest.strip("[]")
                result["depends"] = [d.strip().strip("'\"") for d in rest.split(",") if d.strip()]
            else:
                in_depends = True
        elif in_depends:
            if stripped.startswith("- "):
                result["depends"].append(stripped[2:].strip().strip("'\""))
            else:
                in_depends = False

    return result


# ── Outline parsing ────────────────────────────────────────────────

def parse_outline(outline_path):
    """
    Parse an OUTLINE.md file.
    Returns a list of (section, slug, row_index, outline_stage) in order of
    appearance. outline_stage is the row's Stage column (the last non-empty
    cell after the slug link), or None if the row has no stage cell.
    """
    entries = []
    current_section = None
    row_index = 0

    with open(outline_path, "r") as f:
        for line in f:
            # Detect section headers
            m = re.match(r'^##\s+(I+|III|IV|V|A|B)\.\s', line)
            if m:
                current_section = m.group(1)
                continue

            # Also detect "## Appendices:" style headers
            if re.match(r'^##\s+Appendices', line):
                current_section = "A"  # default; will be overridden by table content
                continue

            # Parse table rows with slug references
            # Format: | § | Type | [N |] [#slug](src/slug.md) | Claim | Stage |
            m = re.search(r'\[#([a-zA-Z0-9_-]+)\]\(src/', line)
            if m:
                slug = m.group(1)
                # Try to get section from the first column
                cols = [c.strip() for c in line.split("|")]
                if len(cols) >= 2:
                    sec = cols[1].strip()
                    if sec in ("I", "II", "III", "IV", "V", "A", "B"):
                        current_section = sec

                # Stage = last non-empty cell (column layouts vary per component)
                stage = None
                if line.strip().startswith("|"):
                    non_empty = [c for c in cols if c]
                    # Require the stage cell to come after the slug link's cell
                    if non_empty:
                        last = non_empty[-1]
                        if f"#{slug}" not in last:
                            stage = last

                entries.append((current_section, slug, row_index, stage))
                row_index += 1

    return entries


# ── Accepted-violations whitelist ──────────────────────────────────

def load_accepted_orderings(outline_dir):
    """
    Load <outline_dir>/OUTLINE-accepted.md — the accepted-by-design
    ordering-violation whitelist. Rows are keyed by (segment, dependency)
    slug pair, so they survive OUTLINE row moves; a slug rename strands the
    entry, which is then reported as stale (warning, non-fatal).

    Format: markdown table rows `| segment | depends-on | accepted | reason |`.
    Returns {(slug, dep): reason}.
    """
    accepted = {}
    path = outline_dir / "OUTLINE-accepted.md"
    if not path.exists():
        return accepted
    with open(path, "r") as f:
        for line in f:
            line = line.strip()
            if not line.startswith("|"):
                continue
            cols = [c.strip() for c in line.strip("|").split("|")]
            if len(cols) < 4 or cols[0] in ("segment", "") or set(cols[0]) <= {"-", " ", ":"}:
                continue
            slug = cols[0].lstrip("#")
            dep = cols[1].lstrip("#")
            reason = cols[3]
            accepted[(slug, dep)] = reason
    return accepted


# ── Violation detection ────────────────────────────────────────────

def find_ordering_violations(entries, all_deps):
    """
    Find cases where a segment appears before one of its dependencies
    in the outline ordering.

    Classifies violations as:
    - "intra-section": both slug and dep are in the same section (true violations)
    - "backmatter": dep is in an appendix section (A, B) and slug is in a main
      section (I, II, III) — intentional presentation order (results before proofs)
    - "cross-section": other cross-section violations
    """
    APPENDIX_SECTIONS = {"A", "B"}
    MAIN_SECTIONS = {"I", "II", "III", "IV", "V"}

    slug_to_index = {}
    slug_to_section = {}
    for section, slug, idx, _stage in entries:
        slug_to_index[slug] = idx
        slug_to_section[slug] = section

    violations = []
    for section, slug, idx, _stage in entries:
        deps = all_deps.get(slug, [])
        for dep in deps:
            dep_idx = slug_to_index.get(dep)
            if dep_idx is not None and dep_idx > idx:
                dep_section = slug_to_section.get(dep)
                if section == dep_section:
                    kind = "intra-section"
                elif dep_section in APPENDIX_SECTIONS and section in MAIN_SECTIONS:
                    kind = "backmatter"
                elif dep_section in APPENDIX_SECTIONS and section in APPENDIX_SECTIONS:
                    kind = "intra-appendix"
                else:
                    kind = "cross-section"

                violations.append({
                    "slug": slug,
                    "slug_idx": idx,
                    "dep": dep,
                    "dep_idx": dep_idx,
                    "section": section,
                    "dep_section": dep_section,
                    "kind": kind,
                })

    return violations


def find_missing_deps(all_deps, existing_slugs):
    """Find dependencies that reference non-existent slugs."""
    missing = []
    for slug, deps in all_deps.items():
        for dep in deps:
            if dep not in existing_slugs:
                missing.append({"slug": slug, "dep": dep})
    return missing


def find_orphan_segments(src_dir, outline_slugs, all_slugs):
    """Find src/ files not referenced in the outline."""
    orphans = []
    for slug in all_slugs:
        if slug not in outline_slugs and not slug.startswith("old-"):
            orphans.append(slug)
    return orphans


STAGE_VOCABULARY = {"missing", "old", "draft", "deps-verified",
                    "claims-verified", "format-clean", "candidate"}


def find_stage_issues(entries, slug_to_meta, component_slugs):
    """
    Check frontmatter `stage:` vs the OUTLINE row's stage column
    (format.sop.md §stage: "A script can verify consistency between the two").

    Flags, per OUTLINE row (old-* segments exempt per FORMAT):
      - off-vocab-outline:     stage column value not in the stage vocabulary
      - off-vocab-frontmatter: frontmatter stage: not in the stage vocabulary
      - no-frontmatter-stage:  segment file exists but has no stage: field
      - mismatch:              both present and in-vocabulary but disagree
      - missing-file-mismatch: OUTLINE stage says a file state inconsistent
                               with whether the file exists
    """
    issues = []
    for _sec, slug, _idx, outline_stage in entries:
        if slug.startswith("old-"):
            continue
        file_exists = slug in component_slugs
        fm_stage = slug_to_meta.get(slug, {}).get("stage") if file_exists else None

        if outline_stage is not None and outline_stage not in STAGE_VOCABULARY:
            issues.append({"slug": slug, "kind": "off-vocab-outline",
                           "detail": f"OUTLINE stage column reads '{outline_stage}' — not in vocabulary"})
            continue  # can't meaningfully compare further

        if outline_stage in ("missing", "old"):
            if file_exists:
                issues.append({"slug": slug, "kind": "missing-file-mismatch",
                               "detail": f"OUTLINE stage '{outline_stage}' but src/{slug}.md exists"
                                         + (f" (frontmatter stage: {fm_stage})" if fm_stage else "")})
            continue

        if not file_exists:
            # No file: only 'missing'/'old' outline stages are consistent
            if outline_stage is not None:
                issues.append({"slug": slug, "kind": "missing-file-mismatch",
                               "detail": f"OUTLINE stage '{outline_stage}' but no src/{slug}.md file (expected 'missing' or 'old')"})
            continue

        if fm_stage is None:
            issues.append({"slug": slug, "kind": "no-frontmatter-stage",
                           "detail": f"src/{slug}.md has no stage: field"
                                     + (f" (OUTLINE says '{outline_stage}')" if outline_stage else "")})
            continue

        if fm_stage not in STAGE_VOCABULARY:
            issues.append({"slug": slug, "kind": "off-vocab-frontmatter",
                           "detail": f"frontmatter stage: '{fm_stage}' — not in vocabulary"})
            continue

        if outline_stage is not None and fm_stage != outline_stage:
            issues.append({"slug": slug, "kind": "mismatch",
                           "detail": f"frontmatter stage: '{fm_stage}' ≠ OUTLINE stage '{outline_stage}'"})

    return issues


# ── Graphviz output ────────────────────────────────────────────────

SECTION_COLORS = {
    "I": "#4a86c8",
    "II": "#e07b39",
    "III": "#6b9e3c",
    "A": "#888888",
    "B": "#aa7744",
}

SECTION_BG = {
    "I": "#eef3fa",
    "II": "#fdf3ec",
    "III": "#f0f5eb",
    "A": "#f5f5f5",
    "B": "#f8f4ef",
}

TYPE_COLORS = {
    "postulate":        "#8e44ad",  # purple — foundational axioms
    "definition":       "#2980b9",  # blue — what things are
    "formulation":      "#2471a3",  # darker blue — representational choices
    "scope":            "#7f8c8d",  # gray — boundary conditions
    "derived":          "#27ae60",  # green — proved results
    "result":           "#1e8449",  # darker green — major results
    "hypothesis":       "#e67e22",  # orange — conjectured
    "discussion":       "#d4ac0d",  # gold — interpretive
    "empirical":        "#e74c3c",  # red — data-driven
    "normative":        "#c0392b",  # darker red — prescriptive
    "derivation":       "#27ae60",  # green — proof appendix
    "sketch":           "#95a5a6",  # light gray — incomplete
    "detail":           "#95a5a6",  # light gray — supporting
    "worked-example":   "#16a085",  # teal — instantiation
    "proposed-schema":  "#e67e22",  # orange — not yet proved
    "observation":      "#e74c3c",  # red — empirical
    "derived + scope":  "#27ae60",  # green
    "definition + discussion": "#2980b9",  # blue
}

APPENDIX_SECTIONS = {"A", "B"}
MAIN_SECTIONS = {"I", "II", "III", "IV", "V"}


TYPE_PREFIXES = {
    "postulate":        "POS",
    "definition":       "DEF",
    "formulation":      "FORM",
    "scope":            "SCOPE",
    "derived":          "DER",
    "result":           "RES",
    "hypothesis":       "HYP",
    "discussion":       "DSC",
    "empirical":        "EMP",
    "normative":        "NORM",
    "derivation":       "DERIV",
    "sketch":           "SKTCH",
    "detail":           "DTL",
    "worked-example":   "EX",
    "proposed-schema":  "SCHMA",
    "observation":      "OBS",
    "derived + scope":  "DER",
    "definition + discussion": "DEF",
}


def _title_case(slug):
    """Convert a slug to Title Case: 'gain-sector-bridge' → 'Gain Sector Bridge'."""
    return " ".join(word.capitalize() for word in slug.split("-"))


def _short_label(slug, seg_type=None):
    """Make a compact, title-cased label with type prefix from a slug."""
    title = _title_case(slug)

    # Add type prefix
    prefix = ""
    if seg_type:
        seg_type_lower = seg_type.strip().lower()
        prefix = TYPE_PREFIXES.get(seg_type_lower, seg_type_lower[:4].upper())
        prefix = f"{prefix}: "

    full = f"{prefix}{title}"

    # Wrap at ~22 chars per line
    words = full.split(" ")
    lines = []
    current = words[0]
    for w in words[1:]:
        if len(current) + len(w) + 1 > 22:
            lines.append(current)
            current = w
        else:
            current += " " + w
    lines.append(current)
    return "\\n".join(lines)


def write_dot(entries, all_deps, slug_to_section, slug_to_meta, filepath,
              section_filter=None, exclude_sections=None):
    """Write a Graphviz DOT file."""
    exclude_sections = set(exclude_sections or [])

    # Determine which slugs to include
    if section_filter:
        include = {slug for sec, slug, _, _ in entries if sec == section_filter}
        # Track which nodes have external deps (for marking) but don't show them
        has_external_deps = set()
        for slug in include:
            for dep in all_deps.get(slug, []):
                if dep not in include:
                    has_external_deps.add(slug)
        external = set()  # empty — don't render external nodes in section views
    else:
        include = {slug for sec, slug, _, _ in entries if sec not in exclude_sections}
        has_external_deps = set()
        external = set()
        for slug in include:
            for dep in all_deps.get(slug, []):
                if dep not in include:
                    external.add(dep)

    # Desired section ordering for vertical layout
    SECTION_ORDER = ["I", "II", "III", "A", "B"]

    with open(filepath, "w") as f:
        f.write("digraph AAT_Dependencies {\n")
        f.write("  rankdir=TB;\n")
        f.write("  compound=true;\n")
        f.write("  concentrate=true;\n")
        f.write("  splines=ortho;\n")
        f.write("  ranksep=0.5;\n")
        f.write("  nodesep=0.2;\n")
        f.write('  node [shape=box fontsize=8 fontname="Helvetica" height=0.3 margin="0.06,0.04"];\n')
        f.write('  edge [color="#999999" arrowsize=0.5];\n\n')

        # Group by section using subgraphs
        sections_seen = {}
        for sec, slug, _, _ in entries:
            if slug in include:
                if sec not in sections_seen:
                    sections_seen[sec] = []
                sections_seen[sec].append(slug)

        for sec, slugs in sections_seen.items():
            color = SECTION_COLORS.get(sec, "#999999")
            bg = SECTION_BG.get(sec, "#fafafa")
            f.write(f"  subgraph cluster_{sec} {{\n")
            sec_label = {"A": "Appendices: Details", "B": "Appendices: Domains"}.get(sec, f"Section {sec}")
            f.write(f'    label="{sec_label}";\n')
            f.write(f'    color="{color}";\n')
            f.write(f'    fontcolor="{color}";\n')
            f.write(f'    bgcolor="{bg}";\n')
            f.write(f"    fontsize=11;\n")
            f.write(f"    style=rounded;\n")
            f.write(f"    penwidth=1.5;\n\n")

            for slug in slugs:
                meta = slug_to_meta.get(slug, {})
                stage = meta.get("stage", "draft")
                seg_type = (meta.get("type") or "").strip().lower()
                label = _short_label(slug, meta.get("type"))
                # Mark nodes with external dependencies
                if slug in has_external_deps:
                    label += " ↑"

                # Color from type
                fill = TYPE_COLORS.get(seg_type, "#cccccc")
                # Lighten fill, use full color for border
                # Convert hex to lighter version for fill
                r, g, b = int(fill[1:3], 16), int(fill[3:5], 16), int(fill[5:7], 16)
                lr = min(255, r + (255 - r) * 7 // 10)
                lg = min(255, g + (255 - g) * 7 // 10)
                lb = min(255, b + (255 - b) * 7 // 10)
                light_fill = f"#{lr:02x}{lg:02x}{lb:02x}"

                # Double outline for claims-verified
                if stage == "claims-verified":
                    peripheries = "peripheries=2"
                    penwidth = "penwidth=2.0"
                else:
                    peripheries = ""
                    penwidth = "penwidth=1.0"

                # Slightly muted for draft (lower saturation border)
                if stage == "draft":
                    # Desaturate the border color
                    dr = r + (128 - r) // 3
                    dg = g + (128 - g) // 3
                    db = b + (128 - b) // 3
                    border = f"#{dr:02x}{dg:02x}{db:02x}"
                else:
                    border = fill

                attrs = f'style=filled fillcolor="{light_fill}" color="{border}" {penwidth}'
                if peripheries:
                    attrs += f" {peripheries}"
                f.write(f'    "{slug}" [{attrs} label="{label}"];\n')

            f.write("  }\n\n")

        # External nodes
        if external:
            # In per-section views, force external deps to the top rank
            if section_filter:
                f.write("  { rank=source;\n")
                for slug in sorted(external):
                    f.write(f'    "{slug}" [style=dashed color="#cccccc" fontcolor="#999999" label="{_short_label(slug, None)}"];\n')
                f.write("  }\n\n")
            else:
                for slug in external:
                    f.write(f'  "{slug}" [style=dashed color="#cccccc" fontcolor="#999999" label="{_short_label(slug, None)}"];\n')
                f.write("\n")

        # Edges — classify backmatter vs intra-section
        for slug in include:
            slug_sec = slug_to_section.get(slug)
            for dep in all_deps.get(slug, []):
                if dep not in include and dep not in external:
                    continue
                dep_sec = slug_to_section.get(dep)

                # Backmatter edge: main body depends on appendix proof
                if slug_sec in MAIN_SECTIONS and dep_sec in APPENDIX_SECTIONS:
                    f.write(f'  "{dep}" -> "{slug}" [style=dashed color="#cccccc" constraint=false];\n')
                # Cross-section edge between main sections — keep constraint
                # so the dependency flow forces vertical section ordering
                elif slug_sec != dep_sec and slug_sec in MAIN_SECTIONS and dep_sec in MAIN_SECTIONS:
                    f.write(f'  "{dep}" -> "{slug}" [color="#aaaaaa"];\n')
                # Intra-appendix cross-reference
                elif slug_sec in APPENDIX_SECTIONS and dep_sec in APPENDIX_SECTIONS and slug_sec != dep_sec:
                    f.write(f'  "{dep}" -> "{slug}" [color="#bbbbbb"];\n')
                else:
                    # Normal intra-section edge
                    sec_color = SECTION_COLORS.get(slug_sec, "#666666")
                    f.write(f'  "{dep}" -> "{slug}" [color="{sec_color}"];\n')

        f.write("}\n")


# ── Main ───────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]

    # Parse arguments
    graph_file = None
    svg_file = None
    section_filter = None
    diagrams = False
    quiet = False
    outline_file = None

    i = 0
    while i < len(args):
        if args[i] == "--graph":
            i += 1
            graph_file = args[i]
        elif args[i] == "--svg":
            i += 1
            svg_file = args[i]
        elif args[i] == "--section":
            i += 1
            section_filter = args[i]
        elif args[i] == "--diagrams":
            diagrams = True
        elif args[i] == "--quiet":
            quiet = True
        elif args[i] == "--help":
            print(__doc__)
            sys.exit(0)
        elif not args[i].startswith("-"):
            outline_file = args[i]
        i += 1

    # Resolve paths
    script_dir = Path(__file__).resolve().parent
    project_root = script_dir.parent

    COMPONENTS = ["01-aat-core", "02-tst-core", "03-llm-core", "04-eli-core"]
    graph_mode = bool(graph_file or svg_file or diagrams)

    if outline_file is not None:
        outline_files = [Path(outline_file)]
    elif graph_mode:
        # Graph outputs are single-outline; keep the historical default, loudly.
        outline_files = [project_root / "01-aat-core" / "OUTLINE.md"]
        print(f"Note: graph output is single-outline; defaulting to {outline_files[0]}", file=sys.stderr)
    else:
        outline_files = [project_root / c / "OUTLINE.md" for c in COMPONENTS]

    for f in outline_files:
        if not f.exists():
            print(f"Error: {f} not found", file=sys.stderr)
            sys.exit(1)

    # ── Collect segment metadata across ALL components ─────────────
    # Dependencies are cross-component by design (see agents.sop.md), so the
    # missing-dependency check resolves against the union of all src/ dirs.

    global_slugs = set()            # all slugs across every component
    slug_to_meta = {}               # slug → {stage, type, status, depends}
    component_src = {}              # src_dir → set of slugs in that src/

    src_dirs = {project_root / c / "src" for c in COMPONENTS}
    src_dirs.update(f.parent / "src" for f in outline_files)

    for src_dir in sorted(src_dirs):
        slugs_here = set()
        if src_dir.exists():
            for md_file in sorted(src_dir.glob("*.md")):
                meta = parse_frontmatter(md_file)
                slug = meta["slug"] or md_file.stem
                slugs_here.add(slug)
                global_slugs.add(slug)
                slug_to_meta[slug] = {
                    "stage": meta["stage"],
                    "type": meta["type"],
                    "status": meta["status"],
                    "depends": meta["depends"],
                }
        component_src[src_dir] = slugs_here

    has_issues = False
    entries = []
    all_deps = {}
    slug_to_section = {}
    outline_dir = outline_files[0].parent

    for outline_file in outline_files:
        outline_dir = outline_file.parent
        src_dir = outline_dir / "src"
        component_slugs = component_src.get(src_dir, set())
        multi = len(outline_files) > 1

        if multi:
            print(f"\n{'#'*60}")
            print(f"# {outline_file.relative_to(project_root) if outline_file.is_relative_to(project_root) else outline_file}")
            print(f"{'#'*60}")

        # Per-component deps (for ordering) — restricted to this src/
        all_deps = {slug: slug_to_meta[slug]["depends"] for slug in component_slugs}

        # ── Parse outline ──────────────────────────────────────────

        entries = parse_outline(outline_file)
        outline_slugs = {slug for _, slug, _, _ in entries}

        slug_to_section = {}
        for sec, slug, _, _ in entries:
            slug_to_section[slug] = sec

        # ── Check for violations ───────────────────────────────────

        violations = find_ordering_violations(entries, all_deps)
        missing = find_missing_deps(all_deps, global_slugs)
        orphans = find_orphan_segments(src_dir, outline_slugs, component_slugs)
        stage_issues = find_stage_issues(entries, slug_to_meta, component_slugs)
        accepted_map = load_accepted_orderings(outline_dir)

        # Filter by section if requested
        if section_filter:
            violations = [v for v in violations if v["section"] == section_filter]

        # Separate violations by kind, then split off accepted-by-design ones
        candidate_violations = [v for v in violations if v["kind"] in ("intra-section", "intra-appendix", "cross-section")]
        backmatter_refs = [v for v in violations if v["kind"] == "backmatter"]
        true_violations = [v for v in candidate_violations if (v["slug"], v["dep"]) not in accepted_map]
        accepted_violations = [v for v in candidate_violations if (v["slug"], v["dep"]) in accepted_map]
        seen_pairs = {(v["slug"], v["dep"]) for v in candidate_violations}
        stale_accepted = sorted(pair for pair in accepted_map if pair not in seen_pairs)

        if true_violations:
            has_issues = True
            print(f"\n{'='*60}")
            print(f" ORDERING VIOLATIONS ({len(true_violations)})")
            print(f"{'='*60}\n")
            for v in true_violations:
                kind_label = f"[{v['kind']}]"
                print(f"  {v['slug']} (§{v['section']}, row {v['slug_idx']}) depends on {v['dep']} (§{v.get('dep_section','?')}, row {v['dep_idx']})  {kind_label}")
                print(f"    → {v['slug']} must come AFTER {v['dep']}")
                print()

        if accepted_violations and not quiet:
            print(f"\n{'='*60}")
            print(f" ACCEPTED ORDERING VIOLATIONS ({len(accepted_violations)}) — by design, per OUTLINE-accepted.md")
            print(f"{'='*60}\n")
            for v in accepted_violations:
                reason = accepted_map[(v["slug"], v["dep"])]
                print(f"  ✓ {v['slug']} (§{v['section']}) before its dep {v['dep']} (§{v.get('dep_section','?')})  [{v['kind']}]")
                print(f"      accepted: {reason}")
            print()

        if stale_accepted:
            print(f"\n  Warning: {len(stale_accepted)} stale OUTLINE-accepted.md entr{'y' if len(stale_accepted)==1 else 'ies'} (no longer a violation — resolved or slug renamed):")
            for slug, dep in stale_accepted:
                print(f"    {slug} → {dep}")

        if backmatter_refs and not quiet:
            print(f"\n{'='*60}")
            print(f" BACKMATTER REFERENCES ({len(backmatter_refs)}) — intentional presentation order")
            print(f"{'='*60}\n")
            for v in backmatter_refs:
                print(f"  {v['slug']} (§{v['section']}) references proof in {v['dep']} (§{v.get('dep_section','?')})")
            print()

        if missing:
            has_issues = True
            print(f"\n{'='*60}")
            print(f" MISSING DEPENDENCIES ({len(missing)})")
            print(f"{'='*60}\n")
            for m in missing:
                print(f"  {m['slug']} depends on {m['dep']} — no such file in any component's src/")

        if orphans and not quiet:
            print(f"\n{'='*60}")
            print(f" ORPHAN SEGMENTS ({len(orphans)})")
            print(f"{'='*60}\n")
            for o in sorted(orphans):
                print(f"  src/{o}.md — not referenced in outline")

        if stage_issues:
            # Warning-only, deliberately not exit-code-affecting (Joseph, 2026-07-14):
            # the stage layer goes stale fast under rearranging/refinement and is
            # systematically ignored in current practice; the gating methodology is
            # under reconsideration (see the meta-process review, promotion-terminus
            # question). Surfacing drift is useful; failing the gate on it is not.
            print(f"\n{'='*60}")
            print(f" STAGE INCONSISTENCIES ({len(stage_issues)}) — warning only — frontmatter vs OUTLINE stage column")
            print(f"{'='*60}\n")
            for s in stage_issues:
                print(f"  {s['slug']}: [{s['kind']}] {s['detail']}")
            print()

        # ── Summary ────────────────────────────────────────────────

        if not quiet:
            print(f"\n{'='*60}")
            print(f" SUMMARY")
            print(f"{'='*60}\n")
            print(f"  Outline entries:      {len(entries)}")
            print(f"  Segment files:        {len(component_slugs)}")
            print(f"  Ordering violations:  {len(true_violations)}")
            print(f"  Accepted (by design): {len(accepted_violations)}")
            print(f"  Backmatter refs:      {len(backmatter_refs)}")
            print(f"  Missing dependencies: {len(missing)}")
            print(f"  Orphan segments:      {len(orphans)}")
            print(f"  Stage inconsistencies:{len(stage_issues):2d}")

            # Stage distribution
            stages = defaultdict(int)
            for slug in outline_slugs:
                meta = slug_to_meta.get(slug, {})
                stage = meta.get("stage") or "unknown"
                stages[stage] += 1
            print(f"\n  Stage distribution:")
            for stage in ["candidate", "format-clean", "claims-verified", "deps-verified", "draft", "old", "missing", "unknown"]:
                if stages[stage]:
                    print(f"    {stage:20s} {stages[stage]:3d}")

    # ── Graph output (single-outline; uses the last-processed outline) ──

    if graph_file:
        write_dot(entries, all_deps, slug_to_section, slug_to_meta, graph_file, section_filter)
        if not quiet:
            print(f"\n  Graph written to: {graph_file}")

    if svg_file:
        dot_path = str(Path(svg_file).with_suffix(".dot"))
        write_dot(entries, all_deps, slug_to_section, slug_to_meta, dot_path, section_filter)
        try:
            subprocess.run(["dot", "-Tsvg", "-o", svg_file, dot_path], check=True)
            if not quiet:
                print(f"  SVG written to: {svg_file}")
                print(f"  DOT written to: {dot_path}")
        except FileNotFoundError:
            print("  Warning: 'dot' command not found. Install graphviz for SVG output.", file=sys.stderr)
            print(f"  DOT file written to: {dot_path}")
        except subprocess.CalledProcessError as e:
            print(f"  Warning: dot failed: {e}", file=sys.stderr)

    # ── Diagrams mode ────────────────────────────────────────────────

    if diagrams:
        img_dir = outline_dir / "src" / "img"
        img_dir.mkdir(exist_ok=True)

        # (section_filter, exclude_sections, filename, description)
        diagram_specs = [
            (None, ["B"], "dep-graph-full.svg", "full dependency graph"),
            ("I", None, "dep-graph-section-I.svg", "Section I"),
            ("II", None, "dep-graph-section-II.svg", "Section II"),
            ("III", None, "dep-graph-section-III.svg", "Section III"),
        ]

        for sec, excl, filename, desc in diagram_specs:
            svg_path = img_dir / filename
            dot_path = svg_path.with_suffix(".dot")
            write_dot(entries, all_deps, slug_to_section, slug_to_meta, str(dot_path), sec, excl)
            try:
                subprocess.run(["dot", "-Tsvg", "-o", str(svg_path), str(dot_path)], check=True)
                if not quiet:
                    print(f"  {desc}: {svg_path}")
            except FileNotFoundError:
                print("  Warning: 'dot' not found. Install graphviz.", file=sys.stderr)
                break
            except subprocess.CalledProcessError as e:
                print(f"  Warning: dot failed for {desc}: {e}", file=sys.stderr)

        if not quiet:
            print()

    if not quiet:
        print()

    sys.exit(1 if has_issues else 0)


if __name__ == "__main__":
    main()
