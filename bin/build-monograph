#!/usr/bin/env ruby
# frozen_string_literal: true
#
# bin/build-monograph — build one or more Agentic Systems volumes to PDF.
#
# Two render targets share the markdown-first pipeline (Stages 1+2 are
# target-agnostic; Stage 3 dispatches per target):
#
#   --target scrbook   (default) vanilla KOMA scrbook — classical math
#                                 monograph register; no Tufte machinery,
#                                 single column, no per-segment chrome
#   --target kaobook              kaobook-styled with Tufte margin notes,
#                                 status badges, segment-tinted boxes
#
# Usage:
#   bin/build-monograph aad                      build AAT volume (scrbook)
#   bin/build-monograph 01                       same, by component-dir prefix
#   bin/build-monograph aad --target kaobook     kaobook variant
#   bin/build-monograph --all                    all four volumes (scrbook)
#   bin/build-monograph --all --target kaobook   all four (kaobook)
#   bin/build-monograph --public aad             public variant (strips Working Notes)
#   bin/build-monograph --no-toc aad             suppress table of contents
#
# Layout:
#   bin/
#     build-monograph             this script
#     lib/                        shared Ruby pipeline
#       outline_walker.rb         OUTLINE.md parser
#       segment_renderer.rb       AsfLatex base converter (math, lists, tables, …)
#       ingest.rb                 Stage 1: source → chunks/ + index.md
#       assemble.rb               Stage 2: chunks + index → assembled markdown
#       typeset.rb                Stage 3 (kaobook): Mono::Typeset
#       typeset_scrbook.rb        Stage 3 (scrbook): Mono::TypesetScrbook
#   mono/
#     kaobook/                    kaobook target — main.tex, preamble/, vendor/kaobook/
#     scrbook/                    scrbook target — main.tex, preamble/
#     .build-kaobook/<slug>/      kaobook stage (gitignored)
#     .build-scrbook/<slug>/      scrbook stage (gitignored)
#     <slug>-v<sem>k.pdf          kaobook artifact
#     <slug>-v<sem>s.pdf          scrbook artifact
#     <slug>-v<sem>.md            assembled markdown (target-agnostic;
#                                 Stage 2's output, byte-identical for both
#                                 targets — whichever build runs writes it)
#   0N-<component>/
#     mono-meta.yaml              per-volume metadata (title, slug, version, cover)
#     OUTLINE.md                  entrypoint outline
#     <slug>.aux                  persisted .aux for sibling-volume xr-refs
#                                 (kaobook target only; scrbook doesn't yet
#                                 do cross-volume refs)

require 'fileutils'
require 'pathname'
require 'open3'
require 'yaml'

ROOT_DIR    = Pathname.new(__dir__).parent.expand_path
LIB_DIR     = Pathname.new(__dir__).expand_path / 'lib'
MONO_DIR    = ROOT_DIR / 'mono'

$LOAD_PATH.unshift(LIB_DIR.to_s)
require 'segment_renderer'
require 'outline_walker'
require 'ingest'
require 'assemble'
require 'typeset'
require 'typeset_scrbook'

# ── Target registry ─────────────────────────────────────────────────────────
#
# Each render target is a small spec naming where its LaTeX template lives
# (under mono/), what build-stage subdir to use, what kramdown converter to
# call for Stage 3, and a few capability flags. Adding a third target is a
# matter of adding an entry here plus a Mono::Typeset… module + LaTeX tree.
#
# `short` is the one-letter PDF filename suffix (`<slug>-v<sem>k.pdf` /
# `<slug>-v<sem>s.pdf`) so the two targets' artifacts coexist in mono/
# without colliding.

TARGETS = {
  'scrbook' => {
    short:           's',
    common_dir:      'scrbook',
    build_dir_name:  '.build-scrbook',
    typeset_module:  'Mono::TypesetScrbook',
    needs_vendor:    false,
    persists_aux:    false,
  },
  'kaobook' => {
    short:           'k',
    common_dir:      'kaobook',
    build_dir_name:  '.build-kaobook',
    typeset_module:  'Mono::Typeset',
    needs_vendor:    true,
    persists_aux:    true,
  },
}.freeze

DEFAULT_TARGET = 'scrbook'
META_FILENAME  = 'mono-meta.yaml'

# ── Volume registry ─────────────────────────────────────────────────────────

# Volume specs in dep order. Each component dir carries a mono-meta.yaml
# with title / short_title / slug / major / minor / patch / cover_svg.
# This table maps the CLI volume id (slug or numeric prefix) to its dir.
VOLUME_REGISTRY = [
  { dir: '01-aat-core',         id_aliases: %w[01 aat] },
  { dir: '02-tst-core',         id_aliases: %w[02 tst] },
  { dir: '03-llm-core', id_aliases: %w[03 llm loga logogenic] },
  { dir: '04-eli-core',              id_aliases: %w[04 eli] },
].freeze

def load_volume_spec(volume_id)
  entry = VOLUME_REGISTRY.find { |e| e[:id_aliases].include?(volume_id.downcase) }
  abort usage_message("unknown volume id: #{volume_id}") unless entry

  comp_dir = ROOT_DIR / entry[:dir]
  meta_path = comp_dir / META_FILENAME
  abort "no #{META_FILENAME} in #{entry[:dir]}" unless meta_path.exist?

  meta = YAML.safe_load(meta_path.read) || {}

  slug = meta['slug'] || entry[:id_aliases].find { |a| a !~ /^\d+$/ } || entry[:id_aliases].first
  major = meta['major'] || 0
  minor = meta['minor'] || 0
  patch = meta['patch'] || 0

  toc_enabled = meta.fetch('toc', true) != false

  {
    dir:          entry[:dir],
    comp_dir:     comp_dir,
    slug:         slug,
    title:        meta['title'] || entry[:dir],
    short_title:  meta['short_title'] || slug.upcase,
    major:        major,
    minor:        minor,
    patch:        patch,
    semver:       "#{major}.#{minor}.#{patch}",
    outline:      comp_dir / (meta['outline'] || 'OUTLINE.md'),
    cover_svg:    meta['cover_svg'] ? (comp_dir / meta['cover_svg']) : nil,
    toc_enabled:  toc_enabled,
    meta_path:    meta_path,
  }
end

# ── CLI ─────────────────────────────────────────────────────────────────────

def usage_message(error = nil)
  msg = +''
  msg << "error: #{error}\n\n" if error
  msg << <<~USAGE
    Usage:
      bin/build-monograph <volume>                    build one volume (scrbook target)
      bin/build-monograph <volume> --target <name>    pick render target
      bin/build-monograph --all                       build all volumes
      bin/build-monograph --public <volume>           public variant (strips Working Notes)
      bin/build-monograph --no-toc <volume>           suppress table of contents

    Volume ids: #{VOLUME_REGISTRY.flat_map { |e| e[:id_aliases] }.join(' / ')}
    Targets:    #{TARGETS.keys.join(' / ')}  (default: #{DEFAULT_TARGET})

    Output:     mono/<slug>-v<sem>{k,s}.pdf  (k=kaobook, s=scrbook)
                mono/<slug>-v<sem>.md        (target-agnostic assembled markdown)
  USAGE
  msg
end

def parse_args(argv)
  args = argv.dup
  variant = :review
  toc_override = nil
  target = DEFAULT_TARGET

  if (i = args.index('--public'))
    args.delete_at(i)
    variant = :public
  end
  if (i = args.index('--no-toc'))
    args.delete_at(i)
    toc_override = false
  end
  if (i = args.index('--target'))
    args.delete_at(i)
    target = args.delete_at(i)
    abort usage_message("unknown target: #{target}") unless TARGETS.key?(target)
  end
  if args.include?('--all')
    return {
      volumes:      VOLUME_REGISTRY.map { |e| e[:id_aliases].first },
      target:       target,
      variant:      variant,
      toc_override: toc_override,
    }
  end
  abort usage_message('no volume specified (try `aad` or `--all`)') if args.empty?
  abort usage_message("unexpected args: #{args[1..].join(' ')}") if args.size > 1

  { volumes: [args.first.downcase], target: target, variant: variant, toc_override: toc_override }
end

# ── Git / build-info ────────────────────────────────────────────────────────

def short_sha
  out, status = Open3.capture2('git', '-C', ROOT_DIR.to_s, 'rev-parse', '--short=7', 'HEAD')
  abort 'git: unable to read HEAD short-sha' unless status.success?
  out.strip
end

def working_tree_dirty?
  out, status = Open3.capture2('git', '-C', ROOT_DIR.to_s, 'status', '--porcelain')
  return false unless status.success?
  !out.strip.empty?
end

def write_build_info(stage, spec, cover_rel:, toc_enabled:)
  sha = short_sha
  sha = "#{sha}-dirty" if working_tree_dirty?
  date = Time.now.utc.strftime('%Y-%m-%d')
  toc_flag = toc_enabled ? '\\volumetoctrue' : '\\volumetocfalse'
  (stage / 'build-info.tex').write(<<~TEX)
    \\newcommand{\\buildsemver}{#{spec[:semver]}}
    \\newcommand{\\buildsha}{#{sha}}
    \\newcommand{\\builddate}{#{date}}
    \\newcommand{\\volumetitle}{#{escape_latex(spec[:title])}}
    \\newcommand{\\volumeshorttitle}{#{escape_latex(spec[:short_title])}}
    \\newcommand{\\volumeslug}{#{spec[:slug]}}
    % Cover-page relative path inside the build stage, or empty if no
    % cover artwork is configured (or rsvg-convert failed). main.tex
    % checks emptiness before \\includepdf.
    \\newcommand{\\volumecoverpath}{#{cover_rel}}
    % ToC opt-in/out — set by mono-meta.yaml `toc:` (default true) and
    % CLI --no-toc. main.tex reads \\ifvolumetoc to decide.
    \\newif\\ifvolumetoc
    #{toc_flag}
  TEX
end

# Minimal LaTeX escape for outline-derived strings (NOT for segment body
# content, which goes through the kramdown converter's own escape).
def escape_latex(text)
  text.to_s
      .gsub('\\') { '\textbackslash{}' }
      .gsub('&')  { '\&' }
      .gsub('%')  { '\%' }
      .gsub('$')  { '\$' }
      .gsub('#')  { '\#' }
      .gsub('_')  { '\_' }
      .gsub('{')  { '\{' }
      .gsub('}')  { '\}' }
      .gsub('~')  { '\textasciitilde{}' }
      .gsub('^')  { '\textasciicircum{}' }
end

# ── kaobook vendor patch (idempotent) ───────────────────────────────────────

def patch_kao_sty(vendor_path)
  kao_sty = vendor_path / 'kao.sty'
  return unless kao_sty.exist?

  text = kao_sty.read
  patched = text.sub(/\{Liberation Mono\}/, '{Libertinus Mono}')
  return if patched == text

  kao_sty.write(patched)
  warn 'Patched vendored kao.sty: Liberation Mono → Libertinus Mono'
end

# ── Cover rendering ─────────────────────────────────────────────────────────

def stage_cover_pdf(spec, stage)
  return nil unless spec[:cover_svg]
  src = spec[:cover_svg]
  unless src.exist?
    warn "warn: cover SVG not found: #{src.relative_path_from(ROOT_DIR)}"
    return nil
  end

  covers_dir = stage / 'covers'
  FileUtils.mkdir_p(covers_dir)
  dst = covers_dir / "#{spec[:slug]}-cover.pdf"
  _out, status = Open3.capture2('rsvg-convert', '-f', 'pdf', '-o', dst.to_s, src.to_s)
  unless status.success?
    warn "warn: rsvg-convert failed for #{src.relative_path_from(ROOT_DIR)}"
    return nil
  end
  "covers/#{spec[:slug]}-cover.pdf"
end

# ── Body assembly + typeset ─────────────────────────────────────────────────
#
# Stage 1 (Mono::Ingest) walks OUTLINE + segments → chunks/ + index.md.
# Stage 2 (Mono::Assemble) stitches chunks per index, resolves cross-refs
# → assembled markdown text. Stage 3 (target-specific Mono::Typeset…)
# kramdown-converts the assembled markdown to body.tex.
#
# Both targets call the same Stages 1+2; only the Stage 3 module differs.
# The assembled markdown is byte-identical between targets — it's the
# canonical artifact, written to mono/<slug>-v<sem>.md regardless of which
# target ran.

def assemble_and_typeset(stage, target_spec, variant:)
  assembled_md = Mono::Assemble.assemble(stage: stage)
  typeset_mod  = Object.const_get(target_spec[:typeset_module])
  body_tex     = typeset_mod.typeset(assembled_md, variant: variant)
  (stage / 'body.tex').write(body_tex)
  assembled_md
end

def collect_stats(stage)
  index_path = stage / 'index.md'
  index = YAML.safe_load((index_path.read.split("---\n", 3)[1] || ''),
                         permitted_classes: [Symbol]) || {}
  entries = index['entries'] || []
  {
    rendered: entries.count { |e| e['kind'] == 'segment_chunk' },
    missing:  entries.count { |e| e['kind'] == 'missing' },
    gaps:     entries.count { |e| e['kind'] == 'gap' },
    errors:   0,
  }
end

# ── Compile + output ────────────────────────────────────────────────────────

def stage_sources(spec, target_spec, build_dir)
  # Stem includes the target's one-letter suffix so kaobook and scrbook
  # PDFs coexist in mono/ without colliding (`aad-v0.1.0k.pdf` vs
  # `aad-v0.1.0s.pdf`).
  stem  = "#{spec[:slug]}-v#{spec[:semver]}#{target_spec[:short]}"
  stage = build_dir / spec[:slug]
  FileUtils.mkdir_p(stage)
  common_dir = MONO_DIR / target_spec[:common_dir]
  FileUtils.cp(common_dir / 'main.tex', stage / "#{stem}.tex")
  FileUtils.rm_rf(stage / 'preamble')
  FileUtils.cp_r(common_dir / 'preamble', stage / 'preamble')
  [stage, stem]
end

def run_lualatex(stage, stem, vendor_extra: nil)
  texinputs = vendor_extra ? "#{stage}:#{vendor_extra}:" : "#{stage}:"
  env = { 'TEXINPUTS' => texinputs }
  pdf_path = stage / "#{stem}.pdf"
  log_path = stage / "#{stem}.log"
  cmd = [
    'lualatex',
    '-interaction=nonstopmode',
    '-file-line-error',
    "-output-directory=#{stage}",
    "#{stage}/#{stem}.tex",
  ]
  # Two passes so \cref / \ref / \tableofcontents resolve. Run with CWD =
  # repo root so fontspec's `Path = ./mono/<target>/fonts/...` relative
  # paths resolve to repo-vendored font files (Garamond Premier Pro, etc.).
  #
  # Failure detection is strict and runs on every pass — three independent
  # signals, any one trips:
  #   1. process exit status non-zero (TeX `!` errors + LuaTeX Lua-side
  #      aborts both produce this);
  #   2. " ==> Fatal error" / "no output PDF file produced" in the .log
  #      (canonical LuaTeX last-words signature — caught even when log-line
  #      wrapping defeats the simple :line: regex elsewhere);
  #   3. PDF absent.
  # Stale PDFs from prior successful builds are deleted before each pass
  # so signal (3) means "this run produced nothing," not "a previous run
  # left something behind."
  2.times do |pass|
    FileUtils.rm_f(pdf_path)
    _out, status = Open3.capture2e(env, *cmd, chdir: ROOT_DIR.to_s)
    fatal_excerpt = lualatex_fatal_excerpt(log_path)
    next if status.success? && pdf_path.exist? && fatal_excerpt.nil?

    abort_lualatex_failure(stem, pass, status, pdf_path, log_path, fatal_excerpt)
  end
end

# Scan the .log for LuaTeX's canonical fatal-error signature. Returns the
# matching log excerpt (a window of context around the marker) or nil if
# absent. Catches the case where LuaTeX exits non-zero AND the rarer case
# where the log names a fatal error even though the process happens to
# exit zero — both should abort the build.
def lualatex_fatal_excerpt(log_path)
  return nil unless log_path.exist?
  lines = log_path.readlines
  idx = lines.index do |l|
    l.include?('==> Fatal error occurred') ||
      l.include?('no output PDF file produced')
  end
  return nil unless idx
  lo = [idx - 10, 0].max
  hi = [idx + 2, lines.size - 1].min
  lines[lo..hi].join
end

def abort_lualatex_failure(stem, pass, status, pdf_path, log_path, fatal_excerpt)
  pdf_state =
    if pdf_path.exist?
      "partial (#{pdf_path.size} bytes — pages flushed before the abort)"
    else
      'none'
    end
  msg = +"lualatex (pass #{pass + 1}) failed for #{stem}.\n"
  msg << "  exit:  #{status.exitstatus.inspect}\n"
  msg << "  pdf:   #{pdf_state}\n"
  msg << "  log:   #{log_path.relative_path_from(ROOT_DIR)}\n"
  if fatal_excerpt
    msg << "\nLuaTeX fatal-error excerpt:\n"
    msg << fatal_excerpt.lines.map { |l| "  #{l}" }.join
  else
    msg << "\nNo `==> Fatal error` marker in the log — the failure is a TeX-side\n"
    msg << "error (likely `!` line) that nonstopmode swallowed. Search the log for\n"
    msg << "`^! ` / `:\\d+: ! ` to find it.\n"
  end
  abort msg
end

def copy_outputs(spec, target_spec, stage, stem)
  src_pdf = stage / "#{stem}.pdf"
  dst_pdf = MONO_DIR / "#{stem}.pdf"
  FileUtils.cp(dst_pdf, MONO_DIR / "#{stem}.prior.pdf") if dst_pdf.exist?
  FileUtils.cp(src_pdf, dst_pdf)

  # Persist .aux into the component dir so sibling-volume kaobook builds
  # can read it for cross-volume xr-refs (Phase 1d). Filename is
  # `<slug>.aux`. Only the kaobook target writes this — scrbook is not yet
  # a cross-volume citation source, and writing it would risk both targets
  # racing over the same path.
  if target_spec[:persists_aux]
    src_aux = stage / "#{stem}.aux"
    if src_aux.exist?
      FileUtils.cp(src_aux, spec[:comp_dir] / "#{spec[:slug]}.aux")
    end
  end

  dst_pdf
end

# Persist the assembled markdown to mono/<slug>-v<sem>.md as the citable
# artifact. Filename has no target suffix — Stage 2's output is identical
# regardless of target. Both kaobook and scrbook builds write the same
# bytes; whichever ran most recently wins (idempotent).
def emit_markdown_artifact(spec, assembled_md)
  md_stem = "#{spec[:slug]}-v#{spec[:semver]}"
  dst_md  = MONO_DIR / "#{md_stem}.md"
  FileUtils.cp(dst_md, MONO_DIR / "#{md_stem}.prior.md") if dst_md.exist?
  dst_md.write(assembled_md)
  dst_md
end

# Overfull-hbox sizes that are systematic widesection / workingnotes
# false positives in the kaobook target (segmentrulewidth ≈ textwidth +
# this offset). See the inline note in summarize_errors. Tune by inspecting
# unique recurring values in the log — if a new structural environment
# appears with a different offset, add it here.
WIDESECTION_FALSE_POSITIVE_PT = [163.35951, 153.35951, 162.82196].freeze

def summarize_errors(stage, stem)
  log = stage / "#{stem}.log"
  return unless log.exist?

  errors   = []
  overfull = []  # [[overshoot_pt, line], …]
  log.each_line do |line|
    case line
    when /^! /, /^.+?:\d+: /
      errors << line.strip
    when /^Overfull \\hbox \(([\d.]+)pt too wide\)/
      pt = Regexp.last_match(1).to_f
      # Filter widesection / workingnotes false positives in the kaobook
      # target: tcolorbox content there is intentionally
      # \segmentrulewidth wide, which is ≈163.4pt past \textwidth in
      # kaobook's default geometry. TeX logs every wider-than-textwidth
      # hbox as overfull even though it's contained in the wider tcolorbox
      # on the page. The exact values (163.35951, 153.35951, 162.82196)
      # are constant signatures of this geometry; filter them so the real
      # overflow signal isn't drowned out. Tolerance ±0.6pt covers tiny
      # per-line variation. (The scrbook target has no widesection
      # wrapper, so these false positives don't occur there.)
      next if WIDESECTION_FALSE_POSITIVE_PT.any? { |fp| (pt - fp).abs < 0.6 }
      overfull << [pt, line.strip]
    end
  end

  if !errors.empty?
    warn ''
    warn "LaTeX errors (#{errors.size}):"
    errors.first(20).each { |e| warn "  #{e}" }
    warn "  ... (#{errors.size - 20} more)" if errors.size > 20
  end

  # Overfull \hbox warnings — content extending past its column. Sub-1pt
  # overshoots are usually invisible; the threshold filters those out so
  # the report focuses on the visible-overflow cases.
  visible = overfull.select { |pt, _| pt >= 1.0 }
  unless visible.empty?
    warn ''
    warn "Overfull \\hbox warnings (#{visible.size}, ≥1pt; #{overfull.size - visible.size} sub-pt suppressed):"
    visible.sort_by { |pt, _| -pt }.first(15).each do |pt, line|
      warn "  +#{format('%.1f', pt)}pt: #{line}"
    end
    warn "  ... (#{visible.size - 15} more)" if visible.size > 15
  end
end

# ── Per-volume build ────────────────────────────────────────────────────────

def build_volume(volume_id, target:, variant:, toc_override: nil)
  spec        = load_volume_spec(volume_id)
  target_spec = TARGETS.fetch(target)
  abort "outline not found for #{volume_id}: #{spec[:outline]}" unless spec[:outline].exist?

  build_dir = MONO_DIR / target_spec[:build_dir_name]
  vendor_extra = nil
  if target_spec[:needs_vendor]
    vendor_path = MONO_DIR / target_spec[:common_dir] / 'vendor' / 'kaobook'
    unless vendor_path.exist?
      abort "kaobook not vendored. Expected: #{vendor_path}\n" \
            "Run: cd mono/kaobook/vendor && git clone --depth 1 https://github.com/fmarotta/kaobook.git"
    end
    patch_kao_sty(vendor_path)
    vendor_extra = vendor_path.to_s
  end

  stage, stem = stage_sources(spec, target_spec, build_dir)
  cover_rel = stage_cover_pdf(spec, stage) || ''
  toc_enabled = toc_override.nil? ? spec[:toc_enabled] : toc_override
  write_build_info(stage, spec, cover_rel: cover_rel, toc_enabled: toc_enabled)

  warn "[#{spec[:slug]}/#{target}] ingesting (variant: #{variant})…"
  Mono::Ingest.ingest(spec.merge(toc_enabled: toc_enabled),
                      stage: stage, variant: variant)

  warn "[#{spec[:slug]}/#{target}] assembling + typesetting (toc: #{toc_enabled ? 'on' : 'off'})…"
  assembled_md = assemble_and_typeset(stage, target_spec, variant: variant)
  stats = collect_stats(stage)
  warn "  rendered=#{stats[:rendered]} missing=#{stats[:missing]} " \
       "gaps=#{stats[:gaps]} errors=#{stats[:errors]}"

  warn "[#{spec[:slug]}/#{target}] compiling #{stem}…"
  run_lualatex(stage, stem, vendor_extra: vendor_extra)
  pdf = copy_outputs(spec, target_spec, stage, stem)
  summarize_errors(stage, stem)
  md = emit_markdown_artifact(spec, assembled_md)
  warn "[#{spec[:slug]}/#{target}] → #{pdf.relative_path_from(ROOT_DIR)}"
  warn "[#{spec[:slug]}/#{target}] → #{md.relative_path_from(ROOT_DIR)}"
end

# ── Main ────────────────────────────────────────────────────────────────────

def main
  opts = parse_args(ARGV)
  FileUtils.mkdir_p(MONO_DIR)
  opts[:volumes].each do |vol|
    build_volume(vol,
                 target:       opts[:target],
                 variant:      opts[:variant],
                 toc_override: opts[:toc_override])
  end
end

main if $PROGRAM_NAME == __FILE__
