#!/usr/bin/env ruby
# frozen_string_literal: true
#
# bin/build-monograph — build one or more Agentic Systems volumes to PDF.
#
# Usage:
#   bin/build-monograph aad             # build AAD volume (alias for 01)
#   bin/build-monograph 01              # build AAD volume by component-dir prefix
#   bin/build-monograph tst             # build TST volume
#   bin/build-monograph --all           # build all four volumes (in dep order)
#   bin/build-monograph --public aad    # public variant (strips Working Notes)
#
# Layout (post-Phase 1b restructure):
#   common/                     shared build infrastructure
#     main.tex                  LaTeX entrypoint template
#     preamble/                 LaTeX preamble fragments
#     lib/                      Ruby modules (segment_renderer, outline_walker)
#     vendor/kaobook/           vendored class (gitignored)
#     VERSION                   merged-build VERSION fallback (legacy)
#   mono/                       output directory (all built artifacts)
#     .build/<slug>/            per-volume build staging (gitignored)
#     <slug>-v<M>.<m>.<p>.pdf   per-volume built PDF
#     <slug>-v<M>.<m>.<p>.md    per-volume assembled markdown (when emitted)
#   0N-<component>/             per-volume source
#     mono-meta.yaml            per-volume metadata (title, slug, version, cover)
#     OUTLINE.md                entrypoint outline (role-prefix format)
#     <slug>.aux                persisted .aux for sibling-volume xr-refs (Phase 1d)
#     src/                      segment files

require 'fileutils'
require 'pathname'
require 'open3'
require 'yaml'

ROOT_DIR    = Pathname.new(__dir__).parent.expand_path
COMMON_DIR  = ROOT_DIR / 'common'
LIB_DIR     = COMMON_DIR / 'lib'
VENDOR_KAO  = COMMON_DIR / 'vendor' / 'kaobook'
MONO_DIR    = ROOT_DIR / 'mono'         # output directory
BUILD_DIR   = MONO_DIR / '.build'

$LOAD_PATH.unshift(LIB_DIR.to_s)
require 'segment_renderer'
require 'outline_walker'

# ── Volume registry ─────────────────────────────────────────────────────────

# Volume specs in dep order. Each component dir carries a mono-meta.yaml
# with title / short_title / slug / major / minor / patch / cover_svg.
# This table maps the CLI volume id (slug or numeric prefix) to its dir.
VOLUME_REGISTRY = [
  { dir: '01-aad-core',         id_aliases: %w[01 aad] },
  { dir: '02-tst-core',         id_aliases: %w[02 tst] },
  { dir: '03-logogenic-agents', id_aliases: %w[03 loga logogenic] },
  { dir: '04-eli',              id_aliases: %w[04 eli] },
].freeze

META_FILENAME = 'mono-meta.yaml'

# Load a volume spec from its mono-meta.yaml, merged with the registry entry.
# Returns a hash with all the keys downstream code expects.
def load_volume_spec(volume_id)
  entry = VOLUME_REGISTRY.find { |e| e[:id_aliases].include?(volume_id.downcase) }
  abort usage_message("unknown volume id: #{volume_id}") unless entry

  comp_dir = ROOT_DIR / entry[:dir]
  meta_path = comp_dir / META_FILENAME
  abort "no #{META_FILENAME} in #{entry[:dir]}" unless meta_path.exist?

  meta = YAML.safe_load(meta_path.read) || {}

  slug = meta['slug'] || entry[:id_aliases].find { |a| a !~ /^\d+$/ } || entry[:id_aliases].first
  major = meta['major'] || 0
  minor = meta['minor'] || 0
  patch = meta['patch'] || 0

  {
    dir:          entry[:dir],
    comp_dir:     comp_dir,
    slug:         slug,
    title:        meta['title'] || entry[:dir],
    short_title:  meta['short_title'] || slug.upcase,
    major:        major,
    minor:        minor,
    patch:        patch,
    semver:       "#{major}.#{minor}.#{patch}",
    outline:      comp_dir / (meta['outline'] || 'OUTLINE.md'),
    cover_svg:    meta['cover_svg'] ? (comp_dir / meta['cover_svg']) : nil,
    meta_path:    meta_path,
  }
end

# ── CLI ─────────────────────────────────────────────────────────────────────

def usage_message(error = nil)
  msg = +''
  msg << "error: #{error}\n\n" if error
  msg << <<~USAGE
    Usage:
      bin/build-monograph <volume>              build one volume
      bin/build-monograph --all                 build all volumes
      bin/build-monograph [--public] <volume>   public variant

    Volume ids: #{VOLUME_REGISTRY.flat_map { |e| e[:id_aliases] }.join(' / ')}
  USAGE
  msg
end

def parse_args(argv)
  args = argv.dup
  variant = :review
  if (i = args.index('--public'))
    args.delete_at(i)
    variant = :public
  end
  if args.include?('--all')
    return { volumes: VOLUME_REGISTRY.map { |e| e[:id_aliases].first }, variant: variant }
  end
  abort usage_message('no volume specified (try `aad` or `--all`)') if args.empty?
  abort usage_message("unexpected args: #{args[1..].join(' ')}") if args.size > 1

  { volumes: [args.first.downcase], variant: variant }
end

# ── Git / build-info ────────────────────────────────────────────────────────

def short_sha
  out, status = Open3.capture2('git', '-C', ROOT_DIR.to_s, 'rev-parse', '--short=7', 'HEAD')
  abort 'git: unable to read HEAD short-sha' unless status.success?
  out.strip
end

def working_tree_dirty?
  out, status = Open3.capture2('git', '-C', ROOT_DIR.to_s, 'status', '--porcelain')
  return false unless status.success?
  !out.strip.empty?
end

def write_build_info(stage, spec)
  sha = short_sha
  sha = "#{sha}-dirty" if working_tree_dirty?
  date = Time.now.utc.strftime('%Y-%m-%d')
  (stage / 'build-info.tex').write(<<~TEX)
    \\newcommand{\\buildsemver}{#{spec[:semver]}}
    \\newcommand{\\buildsha}{#{sha}}
    \\newcommand{\\builddate}{#{date}}
    \\newcommand{\\volumetitle}{#{escape_latex(spec[:title])}}
    \\newcommand{\\volumeshorttitle}{#{escape_latex(spec[:short_title])}}
    \\newcommand{\\volumeslug}{#{spec[:slug]}}
  TEX
end

# ── kaobook vendor patch (idempotent) ───────────────────────────────────────

def patch_kao_sty
  kao_sty = VENDOR_KAO / 'kao.sty'
  return unless kao_sty.exist?

  text = kao_sty.read
  patched = text.sub(/\{Liberation Mono\}/, '{Libertinus Mono}')
  return if patched == text

  kao_sty.write(patched)
  warn 'Patched vendored kao.sty: Liberation Mono → Libertinus Mono'
end

# ── Cover rendering ─────────────────────────────────────────────────────────

def stage_cover_pdf(spec, stage)
  return nil unless spec[:cover_svg]
  src = spec[:cover_svg]
  unless src.exist?
    warn "warn: cover SVG not found: #{src.relative_path_from(ROOT_DIR)}"
    return nil
  end

  covers_dir = stage / 'covers'
  FileUtils.mkdir_p(covers_dir)
  dst = covers_dir / "#{spec[:slug]}-cover.pdf"
  _out, status = Open3.capture2('rsvg-convert', '-f', 'pdf', '-o', dst.to_s, src.to_s)
  unless status.success?
    warn "warn: rsvg-convert failed for #{src.relative_path_from(ROOT_DIR)}"
    return nil
  end
  "covers/#{spec[:slug]}-cover.pdf"
end

# ── Body assembly (one volume) ──────────────────────────────────────────────

# Outline-prose lines that are repo-meta, not part of the reader-facing
# theory. Skipped during body assembly.
PROSE_NOISE = [
  /\AWorking draft\./, /\ASee\s+`?FORMAT\.md/, /\ASee\s+`?NOTATION\.md/,
  /\A!\[/, /\AEvery slug is linked/, /\AThe build tool/,
].freeze

def skip_prose?(content)
  PROSE_NOISE.any? { |re| content.match?(re) }
end

def assemble_body(spec, stage, variant:)
  segments_dir = stage / 'segments'
  FileUtils.rm_rf(segments_dir)
  FileUtils.mkdir_p(segments_dir)

  body  = []
  stats = { rendered: 0, missing: 0, gaps: 0, errors: 0 }

  cover_pdf_rel = stage_cover_pdf(spec, stage)
  if cover_pdf_rel
    body << "\\includepdf[pages=1,fitpaper=true]{#{cover_pdf_rel}}"
    body << ''
  end

  appendix_active   = false
  in_part           = false
  seen_part_or_chap = false

  Mono::OutlineWalker.walk(spec[:outline]).each do |item|
    case item[:kind]
    when :volume
      # Volume title is informational here — used by the title-page macros
      # (\volumetitle) but doesn't render an inline heading.
      next

    when :frontmatter
      # \frontmatter handled at the main.tex template level; the walker
      # marker just delimits scope. Subsequent prose / image items inside
      # *Frontmatter* render as front-matter content.
      next

    when :part
      body << "\\part{#{escape_latex(item[:title])}}"
      in_part = true
      seen_part_or_chap = true

    when :appendices
      unless appendix_active
        body << "\\appendix"
        appendix_active = true
      end
      # In the four-volume hierarchy, each *Appendices* group is its own
      # \part (Appendices: Details, Appendices: Operational Domains).
      # Individual appendix segments inside render as \chapter each — see
      # the :segment branch.
      body << "\\part{#{escape_latex(item[:title])}}"
      in_part = true
      seen_part_or_chap = true

    when :preface
      # Preface body is rendered by the :prose/:scope items that follow.
      next

    when :chapter
      if item[:title]
        body << "\\chapter{#{escape_latex(item[:title])}}"
        seen_part_or_chap = true
      elsif !item[:implicit]
        body << "\\chapter*{}"
      end

    when :scope
      body << "\\begin{quote}\\itshape #{escape_latex(item[:content])}\\end{quote}"

    when :prose
      next if skip_prose?(item[:content])
      next unless seen_part_or_chap
      body << escape_latex(item[:content])
      body << ''

    when :image
      # Image references (dependency graphs etc.) — embed once SVG → PDF
      # pipeline lands. Currently skipped.
      next

    when :segment
      slug = item[:slug]
      begin
        tex = Mono::SegmentRenderer.render(item[:path], variant: variant)
        (segments_dir / "#{slug}.tex").write(tex)
        body << "\\input{segments/#{slug}}"
        stats[:rendered] += 1
      rescue StandardError => e
        warn "render failed: #{slug}: #{e.class}: #{e.message}"
        body << "\\par\\textbf{[Render error: #{slug}]}\\par"
        stats[:errors] += 1
      end

    when :missing
      type_label = Kramdown::Converter::AsfLatex::TYPE_LABEL[item[:type].downcase] || item[:type]
      body << "\\missingsegment{#{escape_latex(type_label)}}" \
              "{#{escape_latex(item[:slug])}}" \
              "{#{escape_latex(item[:claim])}}"
      stats[:missing] += 1

    when :gap
      body << "\\outlinegap{#{escape_latex(item[:description])}}"
      stats[:gaps] += 1
    end
  end

  (stage / 'body.tex').write(body.join("\n") + "\n")
  stats
end

# Minimal LaTeX escape for outline-derived strings (NOT for segment body
# content, which goes through the kramdown converter's own escape). Block
# form avoids Ruby gsub's back-reference interpretation of `\&` in
# replacements.
def escape_latex(text)
  text.to_s
      .gsub('\\') { '\textbackslash{}' }
      .gsub('&')  { '\&' }
      .gsub('%')  { '\%' }
      .gsub('$')  { '\$' }
      .gsub('#')  { '\#' }
      .gsub('_')  { '\_' }
      .gsub('{')  { '\{' }
      .gsub('}')  { '\}' }
      .gsub('~')  { '\textasciitilde{}' }
      .gsub('^')  { '\textasciicircum{}' }
end

# ── Compile + output ────────────────────────────────────────────────────────

def stage_sources(spec)
  stem  = "#{spec[:slug]}-v#{spec[:semver]}"
  stage = BUILD_DIR / spec[:slug]
  FileUtils.mkdir_p(stage)
  FileUtils.cp(COMMON_DIR / 'main.tex', stage / "#{stem}.tex")
  FileUtils.rm_rf(stage / 'preamble')
  FileUtils.cp_r(COMMON_DIR / 'preamble', stage / 'preamble')
  [stage, stem]
end

def run_lualatex(stage, stem)
  env = {
    # Vendored kaobook + staging dir on kpathsea search path. Trailing
    # colon merges with the default search path.
    'TEXINPUTS' => "#{stage}:#{VENDOR_KAO}:",
  }
  cmd = [
    'lualatex',
    '-interaction=nonstopmode',
    '-file-line-error',
    "-output-directory=#{stage}",
    "#{stage}/#{stem}.tex",
  ]
  # Two passes so \cref / \ref / \tableofcontents resolve.
  2.times do |pass|
    _out, status = Open3.capture2e(env, *cmd)
    next if (stage / "#{stem}.pdf").exist?

    abort "lualatex (pass #{pass + 1}) produced no PDF for #{stem}. " \
          "See #{stage}/#{stem}.log for the trace."
  end
end

def copy_outputs(spec, stage, stem)
  src_pdf = stage / "#{stem}.pdf"
  dst_pdf = MONO_DIR / "#{stem}.pdf"
  FileUtils.cp(dst_pdf, MONO_DIR / "#{stem}.prior.pdf") if dst_pdf.exist?
  FileUtils.cp(src_pdf, dst_pdf)

  # Persist .aux into the component dir so sibling-volume builds can read
  # it for cross-volume xr-refs (Phase 1d). Filename is `<slug>.aux`.
  src_aux = stage / "#{stem}.aux"
  if src_aux.exist?
    FileUtils.cp(src_aux, spec[:comp_dir] / "#{spec[:slug]}.aux")
  end

  dst_pdf
end

def summarize_errors(stage, stem)
  log = stage / "#{stem}.log"
  return unless log.exist?

  errors = []
  log.each_line do |line|
    case line
    when /^! /, /^.+?:\d+: /
      errors << line.strip
    end
  end
  return if errors.empty?

  warn ''
  warn "LaTeX errors (#{errors.size}):"
  errors.first(20).each { |e| warn "  #{e}" }
  warn "  ... (#{errors.size - 20} more)" if errors.size > 20
end

# ── Per-volume build ────────────────────────────────────────────────────────

def build_volume(volume_id, variant:)
  spec = load_volume_spec(volume_id)
  abort "outline not found for #{volume_id}: #{spec[:outline]}" unless spec[:outline].exist?

  stage, stem = stage_sources(spec)
  write_build_info(stage, spec)
  warn "[#{spec[:slug]}] assembling (variant: #{variant})…"
  stats = assemble_body(spec, stage, variant: variant)
  warn "  rendered=#{stats[:rendered]} missing=#{stats[:missing]} " \
       "gaps=#{stats[:gaps]} errors=#{stats[:errors]}"
  warn "[#{spec[:slug]}] compiling #{stem}…"
  run_lualatex(stage, stem)
  pdf = copy_outputs(spec, stage, stem)
  summarize_errors(stage, stem)
  warn "[#{spec[:slug]}] → #{pdf.relative_path_from(ROOT_DIR)}"
end

# ── Main ────────────────────────────────────────────────────────────────────

def main
  unless VENDOR_KAO.exist?
    abort "kaobook not vendored. Expected: #{VENDOR_KAO}\n" \
          "Run: cd common/vendor && git clone --depth 1 https://github.com/fmarotta/kaobook.git"
  end

  opts = parse_args(ARGV)
  patch_kao_sty
  FileUtils.mkdir_p(MONO_DIR)
  opts[:volumes].each do |vol|
    build_volume(vol, variant: opts[:variant])
  end
end

main if $PROGRAM_NAME == __FILE__
